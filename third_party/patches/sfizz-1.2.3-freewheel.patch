@@ -571,6 +571,14 @@ void sfz::FilePool::waitForBackgroundLoading() noexcept
 {
     std::lock_guard<std::mutex> guard { loadingJobsMutex };
 
+    // Reverie: include requests not yet picked up by the dispatcher (offline only).
